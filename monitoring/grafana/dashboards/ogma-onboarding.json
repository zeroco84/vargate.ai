{
  "uid": "ogma-onboarding",
  "title": "Ogma Onboarding",
  "tags": ["ogma", "onboarding", "vargate"],
  "timezone": "utc",
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Onboarding step duration (P95)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "description": "p95 wall-clock duration of each onboarding step. Buckets configured per T4.7: 0.5/1/2/5/10/30/60/120s. Only successful step completions are observed.",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(vargate_onboarding_step_seconds_bucket{job=\"ogma-gateway\"}[5m])) by (le, step))",
          "legendFormat": "{{step}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 }
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 2,
      "title": "Time to first pull (P50 / P95)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "description": "Wall-clock from SSO sign-in to the first telemetry_records row landing for the tenant. Once-per-tenant observation. Threshold line marks the marketing claim of 60s.",
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(vargate_onboarding_time_to_first_pull_seconds_bucket{job=\"ogma-gateway\"}[1h])) by (le))",
          "legendFormat": "P50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(vargate_onboarding_time_to_first_pull_seconds_bucket{job=\"ogma-gateway\"}[1h])) by (le))",
          "legendFormat": "P95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 60 }
            ]
          },
          "custom.thresholdsStyle": { "mode": "line" }
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 3,
      "title": "Onboarding funnel (last 24h)",
      "type": "barchart",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 8 },
      "description": "Counts per outcome label over the last 24h. `completed` is the desired terminal; the four `abandoned_at_*` labels are populated by a future background sweep (T4.7 reserved the slots but the sweep is unbuilt).",
      "targets": [
        {
          "expr": "sum by (outcome) (increase(vargate_onboarding_completion_total{job=\"ogma-gateway\"}[24h]))",
          "legendFormat": "{{outcome}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "lineWidth": 1, "fillOpacity": 80, "gradientMode": "none" }
        }
      },
      "options": {
        "orientation": "vertical",
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 0,
        "showValue": "auto",
        "stacking": "none",
        "groupWidth": 0.7,
        "barWidth": 0.97,
        "barRadius": 0,
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single" }
      }
    }
  ]
}
